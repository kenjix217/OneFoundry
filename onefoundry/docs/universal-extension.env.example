# Universal extensions: typed Settings constructor > environment > defaults.
# No env file is loaded by Settings; Compose reads .env. No credentials belong here.
# Full setup and bounds: docs/UNIVERSAL_EXTENSION_RUNTIME.md.
EXTENSION_ALLOWED_ORIGINS='[]'
EXTENSION_TIMEOUT_SECONDS=10
EXTENSION_MAX_INPUT_BYTES=65536
EXTENSION_MAX_RESPONSE_BYTES=262144
EXTENSION_WORKER_IMAGE=
EXTENSION_WORKER_MEMORY_MB=256
EXTENSION_WORKER_PROCESSES=32
EXTENSION_WORKER_CPUS=1
EXTENSION_WORKER_MAX_OUTPUT_BYTES=65536
EXTENSION_WORKER_POLL_SECONDS=0.25
EXTENSION_WORKER_HEARTBEAT_SECONDS=30
EXTENSION_WORKER_QUEUE_SECONDS=60
EXTENSION_WEBHOOK_MAX_BYTES=65536
EXTENSION_WEBHOOK_WINDOW_SECONDS=300
