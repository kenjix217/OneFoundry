# Official tunnel-client companion, after connection approval. Placeholders are not runnable.
CONTROL_PLANE_BASE_URL=https://api.openai.com
CONTROL_PLANE_TUNNEL_ID=<actual-approved-memory-tunnel-id>
MCP_SERVER_URL=http://127.0.0.1:<approved-memory-port>/mcp
MCP_OAUTH_TRUSTED_ORIGINS=https://<actual-approved-issuer-origin>
HARPOON_ALLOW_PLAINTEXT_HTTP=true
HARPOON_HOSTS_INCLUDE_LOOPBACK=true
HARPOON_HOSTS_INCLUDE_PRIVATE=false
MCP_MAX_CONCURRENT_REQUESTS=1
LOG_HTTP_RAW_UNSAFE=false
HARPOON_CAPTURE_PAYLOADS=false
ALLOW_REMOTE_UI=false
HEALTH_LISTEN_ADDR=127.0.0.1:0
# Pass the approved restricted runtime key as --control-plane.api-key=file:<owned-0600-key-path>.
# Verify the generated profile has only this MCP binding and no arbitrary REST forwarding targets.
