# Separate mail MCP process only; not loaded automatically. Copy only after approval.
# Reuse the existing Settings DB configuration and MODEL_SECRET_ROOT; no passwords here.
MAIL_PLUGIN_PROJECT_ID=
MAIL_PLUGIN_ACCOUNT_ID=
MAIL_PLUGIN_USERNAME=
# Copy the verified server/port from the existing ready OneFoundry mailbox record.
MAIL_PLUGIN_IMAP_HOST=
MAIL_PLUGIN_IMAP_PORT=
MAIL_PLUGIN_FOLDERS=["INBOX"]
MAIL_PLUGIN_ACTOR_ID=mail-plugin-reader
MAIL_PLUGIN_ID_KEY_ID=
MAIL_PLUGIN_PUBLIC_URL=
# Omit for direct HTTPS; for Secure MCP Tunnel set its exact external resource URL.
# MAIL_PLUGIN_OAUTH_AUDIENCE=
# Default [] keeps a strict scalar audience; Auth0 OIDC also uses its exact UserInfo URL.
MAIL_PLUGIN_OAUTH_AUXILIARY_AUDIENCES=[]
MAIL_PLUGIN_OAUTH_ISSUER=
MAIL_PLUGIN_OAUTH_PUBLIC_KEY_PATH=
MAIL_PLUGIN_OAUTH_SUBJECTS=[]
MAIL_PLUGIN_OAUTH_CLIENTS=[]
MAIL_PLUGIN_OAUTH_SCOPE=mail.read
MAIL_PLUGIN_LISTEN_HOST=127.0.0.1
MAIL_PLUGIN_LISTEN_PORT=
MAIL_PLUGIN_MAX_RESULTS=10
MAIL_PLUGIN_UID_WINDOW=2000
MAIL_PLUGIN_HEADER_BYTES=8192
MAIL_PLUGIN_BODY_CHARS=4000
MAIL_PLUGIN_DEADLINE_SECONDS=60
MAIL_PLUGIN_MAX_CALLS_PER_MINUTE=30
MAIL_PLUGIN_MAX_REQUEST_BYTES=16384
MAIL_PLUGIN_MAX_TOKEN_BYTES=8192
MAIL_PLUGIN_MAX_SESSION_BYTES=2097152
MAIL_PLUGIN_MAX_TOKEN_SECONDS=900
