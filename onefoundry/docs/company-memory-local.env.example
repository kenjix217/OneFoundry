# Explicit environment for the separate local read-only API-key service.
# Install as an operator-owned 0600 file, outside the repository and plugin archive.
# Explicit constructor settings > environment > documented defaults. No dotenv auto-load.
MEMORY_PLUGIN_AUTH_MODE=api_key
MEMORY_PLUGIN_PUBLIC_URL=http://127.0.0.1:<selected-port>/mcp
MEMORY_PLUGIN_LISTEN_HOST=127.0.0.1
MEMORY_PLUGIN_LISTEN_PORT=<selected-port>
MEMORY_PLUGIN_API_KEY_RECORDS_PATH=<absolute-owned-0600-key-digests-JSON-file>
MEMORY_PLUGIN_GRANTS=[{"subject":"<operator-subject>","client_id":"<local-codex-client>","actor_id":"external-memory:codex","project_ids":["<selected-project-UUID>"],"company_read":true,"capture":false,"company_capture":false}]
MEMORY_PLUGIN_MAX_RESULTS=10
MEMORY_PLUGIN_DEADLINE_SECONDS=10
MEMORY_PLUGIN_MAX_IN_FLIGHT=2
MEMORY_PLUGIN_MAX_CALLS_PER_MINUTE=30
MEMORY_PLUGIN_MAX_REQUEST_BYTES=131072
MEMORY_LOCAL_DATABASE_CONTAINER=<installed-OneFoundry-DB-container>
MEMORY_LOCAL_DATABASE_NETWORK=<installed-private-DB-network>
DB_USER=<dedicated-read-only-memory-DB-login>
DB_PASSWORD=
DB_NAME=<installed-OneFoundry-database-name>
DB_PORT=5432
# Leave all MEMORY_PLUGIN_OAUTH_* variables unset in this mode.
# Key records JSON: [{"sha256":"<digest>","subject":"<operator-subject>",
# "client_id":"<local-codex-client>","expires_at":<Unix-expiry-seconds>}].
# Empty list revokes all keys. At most 20 unique digests; startup rejects unknown actors.
# Existing key records remain read-only; a separately approved capture identity
# needs explicit key scopes and the draft-only settings in company-memory-capture.env.example.
# API-key mode never advertises an invented OAuth issuer.
# Client JSON requires server_url, api_key, project_ids, timeout_seconds,
# max_request_bytes and max_response_bytes; keep it owned 0600 and outside this package.
# Restart the local service after an installed application upgrade so it resolves
# the current private database container address. Docker inspection is bootstrap-only;
# the plugin transport has no Docker tools or database credentials.
