# OPTIONAL: set only for separately approved capture grants. Existing read-only
# server credentials stay unchanged. Values have no dotenv auto-load.
MEMORY_PLUGIN_CAPTURE_PREVIEW_SECONDS=300
# A new private draft-only database login, never the app/owner/read-only login.
MEMORY_CAPTURE_DB_USER=
MEMORY_CAPTURE_DB_PASSWORD=
# The approved capture API-key record must explicitly contain BOTH scopes:
# ["memory.read", "memory.capture"]. Existing records omit scopes and remain read-only.
# Grant capture=true only to the approved separate actor/project. Company scope
# additionally requires company_read=true and company_capture=true.
