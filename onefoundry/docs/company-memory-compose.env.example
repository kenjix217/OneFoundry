# Compose interpolation only; the dedicated DB password stays in a separate 0600 file.
# Values must be approved and verified; placeholders deliberately prevent startup.
MEMORY_RUNTIME_IMAGE=sha256:<verified-local-OneFoundry-runtime-image-ID>
MEMORY_PRIVATE_ENV_FILE=<absolute-owned-0600-memory-environment-file>
MEMORY_PUBLIC_KEY_HOST_PATH=<absolute-owned-RSA-public-key-PEM-file>
MEMORY_PUBLIC_KEY_CONTAINER_PATH=/memory-public.pem
MEMORY_DATABASE_NETWORK=<verified-installed-private-database-network>
