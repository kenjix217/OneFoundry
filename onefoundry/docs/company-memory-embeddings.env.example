# Approve schema 0072, derived-index grants and local assets before live activation.
# Use the same settings in the operator indexer, app and separate MCP runtime.
# Paths must be absolute regular files owned by the runtime user or root, with no
# group/other writers. Use a separately reviewed read-only container mount.
MEMORY_SEARCH_MODE=hybrid
MEMORY_EMBEDDING_RUNTIME_PATH=/absolute/approved/native-embedding
MEMORY_EMBEDDING_RUNTIME_SHA256=<sha256-of-approved-native-binary>
MEMORY_EMBEDDING_MODEL_PATH=/absolute/approved/nomic-embed-text-v1.5.f16.gguf
MEMORY_EMBEDDING_MODEL_SHA256=f7af6f66802f4df86eda10fe9bbcfc75c39562bed48ef6ace719a251cf1c2fdb
MEMORY_EMBEDDING_MODEL=native/nomic-embed-text:v1.5
MEMORY_EMBEDDING_CONTEXT_LENGTH=2048
MEMORY_EMBEDDING_DIMENSIONS=768
MEMORY_EMBEDDING_DOCUMENT_PREFIX="search_document: "
MEMORY_EMBEDDING_QUERY_PREFIX="search_query: "
MEMORY_EMBEDDING_TIMEOUT_SECONDS=5
MEMORY_EMBEDDING_MAX_RESPONSE_BYTES=1048576
MEMORY_EMBEDDING_MIN_SIMILARITY=0.5
# Official Apache-2.0 English GGUF, revision 0188c9bf409793f810680a5a431e7b899c46104c:
# https://huggingface.co/nomic-ai/nomic-embed-text-v1.5-GGUF
# No automatic dotenv loading, network inference or runtime model download.
# Explicit typed settings override process environment.
