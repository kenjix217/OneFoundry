# Companion tunnel-client only. Placeholders are deliberately not runnable.
# No dotenv file loads implicitly. Export selected values in its private launch environment.
# Precedence: CLI flags > environment > tunnel-client YAML/profile > defaults.
CONTROL_PLANE_BASE_URL=https://api.openai.com
CONTROL_PLANE_TUNNEL_ID=<actual-approved-tunnel-id>
MCP_SERVER_URL=http://127.0.0.1:<approved-mail-plugin-port>/mcp
MCP_OAUTH_TRUSTED_ORIGINS=https://<actual-auth0-tenant-domain>
# Explicit approval covers HTTP only on this same-host loopback MCP listener.
HARPOON_ALLOW_PLAINTEXT_HTTP=true
HARPOON_HOSTS_INCLUDE_LOOPBACK=true
HARPOON_HOSTS_INCLUDE_PRIVATE=false
MCP_MAX_CONCURRENT_REQUESTS=1
LOG_HTTP_RAW_UNSAFE=false
HARPOON_CAPTURE_PAYLOADS=false
ALLOW_REMOTE_UI=false
HEALTH_LISTEN_ADDR=127.0.0.1:0
# Pass --control-plane.api-key=file:<absolute-protected-runtime-key-path>.
# No key value, static bearer, Cloudflare credential, or extra forwarding target here.
# Verify the generated profile contains no additional main channels or REST targets.
