# Separate MCP companion process. No dotenv auto-load; explicit settings > environment > safe defaults.
# Populate placeholders only after runtime migration/grants and connection approval.
MEMORY_PLUGIN_PUBLIC_URL=http://127.0.0.1:<approved-port>/mcp
MEMORY_PLUGIN_LISTEN_HOST=127.0.0.1
MEMORY_PLUGIN_LISTEN_PORT=<approved-port>
MEMORY_PLUGIN_OAUTH_ISSUER=https://<approved-issuer>/
MEMORY_PLUGIN_OAUTH_AUDIENCE=https://api.openai.com/v1/mcp/<actual-tunnel-id>
MEMORY_PLUGIN_OAUTH_AUXILIARY_AUDIENCES=[]
MEMORY_PLUGIN_OAUTH_PUBLIC_KEY_PATH=<absolute-owned-public-key-PEM-path>
MEMORY_PLUGIN_GRANTS=[{"subject":"<operator-sub>","client_id":"<codex-client-id>","actor_id":"external-memory:codex","project_ids":["<approved-project-UUID>"],"company_read":false,"capture":false,"company_capture":false},{"subject":"<operator-sub>","client_id":"<dot-client-id>","actor_id":"external-memory:dot","project_ids":["<approved-project-UUID>"],"company_read":false,"capture":false,"company_capture":false}]
MEMORY_PLUGIN_MAX_RESULTS=10
MEMORY_PLUGIN_DEADLINE_SECONDS=10
MEMORY_PLUGIN_MAX_IN_FLIGHT=2
MEMORY_PLUGIN_MAX_CALLS_PER_MINUTE=30
MEMORY_PLUGIN_MAX_REQUEST_BYTES=131072
MEMORY_PLUGIN_MAX_TOKEN_BYTES=8192
MEMORY_PLUGIN_MAX_TOKEN_SECONDS=900
# The service reuses the existing DB_* settings with a dedicated memory read login.
# Use onefoundry.memory_plugin_db_role once with approved owner DB_* and new APP_DB_* values.
DB_HOST=<approved-private-database-host>
DB_PORT=<approved-database-port>
DB_NAME=<existing-company-database-name>
DB_USER=<new-dedicated-memory-read-login>
DB_PASSWORD=<provisioned-private-password>
# Clients receive neither DB credentials nor issuer signing keys.
# OAuth tokens stay in native client secure storage; never put token values in this file.
