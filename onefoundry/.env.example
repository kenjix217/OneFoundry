# Copy to .env and set two different long random passwords before starting Compose.
DB_PASSWORD=
APP_DB_PASSWORD=
APP_DB_USER=onefoundry_app
APP_PORT=8765
# Opt-in native Nomic search; leave lexical until the approved current-fact index is complete.
MEMORY_SEARCH_MODE=lexical
MEMORY_EMBEDDING_RUNTIME_PATH=
MEMORY_EMBEDDING_RUNTIME_SHA256=
MEMORY_EMBEDDING_MODEL_PATH=
MEMORY_EMBEDDING_MODEL_SHA256=
MEMORY_EMBEDDING_MODEL=
MEMORY_EMBEDDING_CONTEXT_LENGTH=2048
MEMORY_EMBEDDING_DIMENSIONS=0
MEMORY_EMBEDDING_DOCUMENT_PREFIX=
MEMORY_EMBEDDING_QUERY_PREFIX=
MEMORY_EMBEDDING_TIMEOUT_SECONDS=5
MEMORY_EMBEDDING_MAX_RESPONSE_BYTES=1048576
MEMORY_EMBEDDING_MIN_SIMILARITY=0.5
# OneFoundry business workflow is opt-in: off, records, manual, event.
ONEFOUNDRY_BUSINESS_MODE=off
ONEFOUNDRY_MAX_LINKED_ORDERS=2
ONEFOUNDRY_MAX_MODEL_ATTEMPTS=2
ONEFOUNDRY_MAX_PUBLIC_WEB_CALLS=0
# No application prompt-size cap. An explicit positive byte limit remains supported; zero is invalid.
ONEFOUNDRY_MAX_CONTEXT_BYTES=unlimited
ONEFOUNDRY_MAX_OUTPUT_TOKENS=512
ONEFOUNDRY_MAX_ELAPSED_SECONDS=600
ONEFOUNDRY_COORDINATOR_POLL_SECONDS=5
ONEFOUNDRY_COORDINATOR_LEASE_SECONDS=60
ONEFOUNDRY_COORDINATOR_MAX_ATTEMPTS=3
ONEFOUNDRY_COORDINATOR_ACTOR_ID=onefoundry-coordinator
# Coordination rules: off, draft_only (rules create drafts only), or auto.
COORDINATION_MODE=off
# Generations of automatically created work from one event (1-30).
COORDINATION_MAX_CHAIN_DEPTH=10
# Work orders coordination rules may create per project per day (1-1000).
COORDINATION_MAX_ORDERS_PER_DAY=50
# Time zone for daily and weekly automation schedules (IANA name, e.g. America/New_York).
COORDINATION_TIMEZONE=UTC
# Runs that auto-start rules may launch per project per day (1-500); only in COORDINATION_MODE=auto.
COORDINATION_MAX_AUTO_STARTS_PER_DAY=20
# Read-only IMAP mailboxes added under Automation: check interval and per-message bounds.
MAIL_POLL_SECONDS=60
MAIL_IDLE_ENABLED=true
MAIL_IDLE_WAIT_SECONDS=60
MAIL_TIMEOUT_SECONDS=20
SMTP_TIMEOUT_SECONDS=15
MAIL_MAX_MESSAGE_BYTES=262144
MAIL_MAX_FETCH_PER_POLL=20
# Microsoft and Google sign-in. Leave the redirect empty to use http://127.0.0.1:APP_PORT/.
CONNECTOR_HTTP_TIMEOUT_SECONDS=10
CONNECTOR_GOOGLE_REDIRECT_URI=
ZOHO_OAUTH_PENDING_TIMEOUT_SECONDS=900
ZOHO_OAUTH_AUTHORITY_HOSTS='["mcp.zoho.com","accounts.zoho.com"]'
# Watched OneDrive/SharePoint and Google Drive folders.
DOCUMENT_POLL_SECONDS=300
DOCUMENT_MAX_BYTES=4000000
DOCUMENT_MAX_FILES_PER_POLL=10
DOCUMENT_SEARCH_MAX_PAGES=5
DOCUMENT_SEARCH_MAX_RESULTS=20
DOCUMENT_MAX_RANGE_CELLS=1000
MAILPIT_UI_PORT=8025
# Offline Engineer/QA runner limits. Compose mounts the named spool at this path.
RUNNER_WALL_SECONDS=30
RUNNER_MAX_LOG_BYTES=65536
RUNNER_MAX_DIFF_BYTES=32768
RUNNER_RECEIPT_WAIT_SECONDS=120
# Enables the gateway policy; a fresh, supported runner capability is still required.
EXTERNAL_CODE_ENABLED=true
# Typed maintenance bounds. Constructor values override environment; explicit
# invalid/empty JSON fails startup. Full schema: docs/SELF_EXTENSION_RUNTIME.md.
# The default allows 80 provider requests within the existing time and byte bounds.
REPOSITORY_CODE_POLICY={}
EXTERNAL_CODE_CAPABILITY_MAX_AGE_SECONDS=30
# Used only with compose.trusted-local.yaml. Create an operator-owned mode-2770
# spool and set EXTERNAL_CODE_SHARED_GID to the operator's primary group ID.
EXTERNAL_CODE_HOST_SPOOL=
EXTERNAL_CODE_SHARED_GID=
OFFLINE_SOURCE_PROBE_ENABLED=false
OFFLINE_SOURCE_PROBE_CAPABILITY_MAX_AGE_SECONDS=30
# Host observer writes .infra-status/status.json; app reads a read-only bind mount at /infra/status.json.
INFRA_SNAPSHOT_PATH=/infra/status.json
INFRA_SNAPSHOT_MAX_AGE_SECONDS=20
# Model discovery is explicit; live text calls require a supported bound profile and ready work order.
MODEL_DISCOVERY_TIMEOUT_SECONDS=5
MODEL_DISCOVERY_MAX_PAGES=5
MODEL_DISCOVERY_MAX_RESPONSE_BYTES=1000000
MODEL_DISCOVERY_MAX_MODELS=500
# Codex account device login expiry and account model catalog version.
CODEX_DEVICE_TIMEOUT_SECONDS=600
CODEX_AUTH_EXCHANGE_TIMEOUT_SECONDS=60
CODEX_CATALOG_CLIENT_VERSION=0.160.0
# Public native-client identifier from xai-org/grok-build; empty explicitly disables login.
XAI_OAUTH_CLIENT_ID=b1a00492-073a-47ea-816f-4c329264a828 # gitleaks:allow
XAI_OAUTH_ISSUER=https://auth.x.ai
GROK_ACCOUNT_BASE_URL=https://cli-chat-proxy.grok.com/v1
# The dedicated container source directory grants no host mount. Use scripts/local_repositories.py
# to generate an exact read-only mount for each checkout, or configure a
# dedicated source root in a private Compose override. Never mount the home directory or host root.
LOCAL_SOURCE_ROOT=/source-roots/workspace
LOCAL_SOURCE_SCAN_MAX_ENTRIES=25
LOCAL_SOURCE_SCAN_SECONDS=10
LOCAL_SOURCE_GIT_TIMEOUT_SECONDS=3
# GitHub metadata requests use only the official HTTPS API; tokens are entered
# through the local Integrations UI and stored in the protected credential volume.
GITHUB_API_URL=https://api.github.com
GITHUB_TIMEOUT_SECONDS=5
GITHUB_MAX_RESPONSE_BYTES=262144
GITHUB_PR_READ_APPROVAL_MINUTES=15
# Fake HTTPS snapshot profile only: a dedicated persistent volume mounted read-only in the app.
# No real GitHub content or credentials belong in this volume.
GITHUB_SNAPSHOT_ROOT=/source-snapshots
# Opt-in `offline-github-stage` Compose profile only. Its fixed, marked bare
# remote is generated locally under .offline-github-stage/remote.git.
# No GitHub URL or token is accepted by this supervisor.
GITHUB_STAGE_FIXTURE_OWNER=sample
GITHUB_STAGE_FIXTURE_REPO=project
GITHUB_STAGE_MAX_FILES=1000
GITHUB_STAGE_MAX_BYTES=8388608
GITHUB_STAGE_MAX_TREE_BYTES=1048576
GITHUB_STAGE_WALL_SECONDS=30
GITHUB_STAGE_MAX_GIT_BYTES=16777216
LIVE_TEXT_MAX_PROMPT_BYTES=96000
# Bounded project rule/profile catalogue, Chief team assignments, and saved goal excerpt.
# Values outside 1-50 items or 100-4000 characters fail startup validation.
AGENT_AUTOMATION_CONTEXT_MAX_ITEMS=8
AGENT_AUTOMATION_GOAL_MAX_CHARS=500
SKILL_AUTO_MAX_COUNT=3
SKILL_AUTO_MAX_CONTENT_BYTES=16000
LIVE_TEXT_MAX_OUTPUT_TOKENS=512
LIVE_TEXT_MAX_OUTPUT_BYTES=16000
LIVE_TEXT_TIMEOUT_SECONDS=30
# Task chat may need longer for a reasoning reply; this caps the provider call, not a wait before sending.
TASK_CHAT_TIMEOUT_SECONDS=120
# Core task execution defaults on; profile/model admission still applies.
TEAM_WORKER_ENABLED=true
# Maximum unfinished delegated assignments per root request (1–50).
# Completed and canceled assignments release capacity. Installed CLI changes require restart.
TEAM_MAX_ASSIGNMENTS_PER_ORDER=8
# Safe committed text from selected sources may enter configured team provider contexts.
# Requires an exact read-only mount, selected revision and each profile's repository_file_v1 permission.
# Set false to disable. An explicitly empty LOCAL_SOURCE_ROOT is invalid while enabled.
TEAM_REPOSITORY_READ_ENABLED=true
# Recording begins only after the operator selects a browser source and starts capture.
MEDIA_CAPTURE_ENABLED=true
# Local editing requires a pinned renderer plus the separate trusted worker.
# Compose forwards these settings and initializes its private asset volume.
VIDEO_EDIT_ENABLED=false
VIDEO_EDIT_IMAGE=
VIDEO_EDIT_ASSET_ROOT=/video-edit-assets
VIDEO_EDIT_DOCKER_BINARY=/usr/bin/docker
VIDEO_EDIT_DOCKER_SOCKET=/var/run/docker.sock
VIDEO_EDIT_WALL_SECONDS=120
VIDEO_EDIT_MEMORY_MB=512
VIDEO_EDIT_CPUS=1
VIDEO_EDIT_PIDS=64
VIDEO_EDIT_MAX_SCENES=12
VIDEO_EDIT_MAX_CAPTIONS=64
VIDEO_EDIT_MAX_JOBS_PER_ORDER=3
VIDEO_EDIT_MAX_ATTEMPTS=2
MEDIA_MAX_BYTES=33554432
MEDIA_MAX_DURATION_SECONDS=120
MEDIA_MAX_WIDTH=1280
MEDIA_MAX_HEIGHT=720
MEDIA_FRAME_RATE=24
LIVE_TEXT_TOOL_MAX_TURNS=3
ROLE_CONTEXT_MAX_ITEMS=5
# Only the built-in Researcher with explicit tool permission can use public web.
# Search additionally requires PUBLIC_WEB_SEARCH_ENDPOINT; fetch uses public HTTPS URLs.
PUBLIC_WEB_ENABLED=true
PUBLIC_WEB_SEARCH_ENDPOINT=
PUBLIC_WEB_TIMEOUT_SECONDS=8
PUBLIC_WEB_MAX_RESPONSE_BYTES=65536
PUBLIC_WEB_MAX_TEXT_CHARS=4000
PUBLIC_WEB_MAX_RESULTS=5
# Static HTML/CSS inspection stays off until exact browser image ID and a separate host bridge are configured.
BROWSER_STATIC_ENABLED=false
BROWSER_STATIC_IMAGE_ID=
BROWSER_STATIC_CLAIM_TIMEOUT_SECONDS=240
BROWSER_STATIC_MAX_URL_CHARS=2048
BROWSER_STATIC_MAX_VIEWPORT_WIDTH=1920
BROWSER_STATIC_MAX_VIEWPORT_HEIGHT=1200
BROWSER_STATIC_MAX_PAGE_BYTES=262144
BROWSER_STATIC_MAX_FIXTURE_BYTES=262144
BROWSER_STATIC_MAX_TIMEOUT_SECONDS=30
BROWSER_STATIC_MAX_LIFETIME_SECONDS=300
# Private persistent OneFoundry-authored text artifacts; Compose mounts this named volume.
ARTIFACT_WORKSPACE_ROOT=/artifact-workspace
# Private project input originals and bounded per-project/provider limits.
INPUT_FILE_ROOT=/input-files
INPUT_FILE_MAX_BYTES=26214400
INPUT_FILE_MAX_PROJECT_BYTES=209715200
INPUT_FILE_MAX_PROJECT_COUNT=30
INPUT_FILE_MAX_LINK_COUNT=8
INPUT_FILE_MAX_TEXT_BYTES=262144
INPUT_FILE_MAX_VISUAL_BYTES=8388608
INPUT_FILE_MAX_VISUAL_COUNT=2
# Saved text-chat turns per work-order/role thread (1-1000).
# Recent context and history page size; not a lifetime turn cutoff.
TASK_CONVERSATION_MAX_TURNS=100
# SDK tool-loop calls: unlimited, or a finite integer from 2 to 30.
# Timeout, approvals and usage policies still apply.
TEAM_MAX_MODEL_CALLS_PER_TURN=unlimited
# Remote channels stay disconnected until the operator pairs an exact personal DM.
REMOTE_CHANNEL_NETWORK_ENABLED=true
REMOTE_CHANNEL_POLL_SECONDS=5
REMOTE_IDENTITY_CHALLENGE_SECONDS=600
DISCORD_MAX_TEXT_CHARS=1900
DISCORD_SEND_TIMEOUT_SECONDS=15
# Tencent iLink text transport. Credentials are entered locally, never in this file.
WEIXIN_API_BASE_URL=https://ilinkai.weixin.qq.com
WEIXIN_CHANNEL_VERSION=2.4.9
WEIXIN_APP_CLIENT_VERSION=132105
WEIXIN_BOT_AGENT=OneFoundry/0.1.0
WEIXIN_QR_REQUEST_TIMEOUT_SECONDS=5
WEIXIN_QR_POLL_TIMEOUT_SECONDS=35
WEIXIN_POLL_TIMEOUT_SECONDS=35
WEIXIN_MAX_POLL_TIMEOUT_SECONDS=40
WEIXIN_SEND_TIMEOUT_SECONDS=15
WEIXIN_UPDATE_RETRIES=3
WEIXIN_RETRY_BACKOFF_SECONDS=0.5
WEIXIN_MAX_RESPONSE_BYTES=1048576
WEIXIN_MAX_CURSOR_LENGTH=2048
WEIXIN_MAX_TEXT_LENGTH=8192
LIVE_TEXT_OPENAI_BASE_URL=https://api.openai.com/v1
LIVE_TEXT_ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
LIVE_TEXT_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
LIVE_TEXT_GROK_BASE_URL=https://api.x.ai/v1
# Universal extensions: typed Settings constructor > environment > defaults.
# No env file is loaded by Settings; Compose reads .env. No credentials belong here.
# Full setup and bounds: docs/UNIVERSAL_EXTENSION_RUNTIME.md.
EXTENSION_ALLOWED_ORIGINS='[]'
EXTENSION_TIMEOUT_SECONDS=10
EXTENSION_MAX_INPUT_BYTES=65536
EXTENSION_MAX_RESPONSE_BYTES=262144
EXTENSION_WORKER_IMAGE=
EXTENSION_WORKER_MEMORY_MB=256
EXTENSION_WORKER_PROCESSES=32
EXTENSION_WORKER_CPUS=1
EXTENSION_WORKER_MAX_OUTPUT_BYTES=65536
EXTENSION_WORKER_POLL_SECONDS=0.25
EXTENSION_WORKER_HEARTBEAT_SECONDS=30
EXTENSION_WORKER_QUEUE_SECONDS=60
EXTENSION_WEBHOOK_MAX_BYTES=65536
EXTENSION_WEBHOOK_WINDOW_SECONDS=300
