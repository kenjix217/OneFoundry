{
  "schema_version": 1,
  "id": "account-brief",
  "version": "1.0.0",
  "name": "Account brief",
  "description": "Synthetic account brief with local transformation and operator-bound connections.",
  "connections": [
    {"id": "account_api", "name": "Account API", "kind": "http", "operations": [{"id": "lookup", "method": "GET", "path": "/accounts/{account_id}"}]},
    {"id": "account_mcp", "name": "Account MCP", "kind": "mcp", "operations": [{"id": "lookup_account"}]},
    {"id": "delivery", "name": "Outbound delivery", "kind": "webhook", "operations": [{"id": "send_brief", "method": "POST", "path": "/deliver"}]}
  ],
  "tools": [
    {
      "id": "format_brief", "description": "Normalize a synthetic account note without network access.",
      "effect": "pure", "runtime": "python", "entrypoint": "brief:format_brief",
      "parameters": {"type": "object", "properties": {"account": {"type": "string"}, "note": {"type": "string"}}, "required": ["account", "note"], "additionalProperties": false},
      "returns": {"type": "object", "properties": {"brief": {"type": "string"}}, "required": ["brief"], "additionalProperties": false}
    },
    {
      "id": "api_lookup", "description": "Look up a synthetic account through an operator-bound HTTP slot.",
      "effect": "read", "runtime": "http", "connection": "account_api", "operation": "lookup",
      "parameters": {"type": "object", "properties": {"account_id": {"type": "string"}}, "required": ["account_id"], "additionalProperties": false},
      "returns": {"type": "object", "properties": {"account": {"type": "string"}}, "required": ["account"], "additionalProperties": false}
    },
    {
      "id": "mcp_lookup", "description": "Look up a synthetic account through an operator-bound MCP slot.",
      "effect": "read", "runtime": "mcp", "connection": "account_mcp", "operation": "lookup_account",
      "parameters": {"type": "object", "properties": {"account_id": {"type": "string"}}, "required": ["account_id"], "additionalProperties": false},
      "returns": {"type": "object", "properties": {"account": {"type": "string"}}, "required": ["account"], "additionalProperties": false}
    },
    {
      "id": "send_brief", "description": "Deliver a synthetic brief after exact operator approval.",
      "effect": "write", "runtime": "http", "connection": "delivery", "operation": "send_brief",
      "parameters": {"type": "object", "properties": {"brief": {"type": "string"}}, "required": ["brief"], "additionalProperties": false},
      "returns": {"type": "object", "properties": {"accepted": {"type": "string"}}, "required": ["accepted"], "additionalProperties": false}
    }
  ],
  "skills": [
    {
      "id": "account_brief", "name": "Account brief", "description": "Prepare and optionally deliver a synthetic account brief.",
      "content": "# Account brief\nLook up an account with api_lookup or mcp_lookup. Use format_brief to normalize the note. Show the draft to the operator. Call send_brief only after the operator requests delivery and approves that exact call. An inbound account.created webhook may create a separate draft work order. This procedure grants no tools or permissions.\n",
      "required_tools": ["api_lookup", "mcp_lookup", "format_brief", "send_brief"]
    }
  ]
}
